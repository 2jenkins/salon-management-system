# Copy to .env for local development only; do not commit real credentials.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset locally to use db.sqlite3.
# DATABASE_URL=postgresql://user:password@host:5432/database
# For production uploads, configure an S3-compatible private bucket:
# AWS_STORAGE_BUCKET_NAME=your-media-bucket
# AWS_S3_REGION_NAME=your-region
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint (optional)
